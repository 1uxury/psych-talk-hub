# Copy to .env for local development or .env.test for local test configuration.
# Blank required values are deliberate. Never commit the filled files.
# Choose DJANGO_ENV in the process environment; production never reads local files.
SECRET_KEY=
DATABASE_URL=
TEST_DATABASE_NAME=test_psychtalk
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Local URL format: postgresql://USER:PASSWORD@127.0.0.1:5433/psych_talk_dev
# Production: explicit hosts, DEBUG=False and a PostgreSQL URL with sslmode=require.
